# Quartus Prime Pro project: MXFP tensor-mode dot product test harness on the Arrow AXC3000.
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CY100BM16AE7S
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
source ../constr/axc3000_board.qsf
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name AUTO_RESTART_CONFIGURATION OFF
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_100MHZ
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name OPTIMIZATION_MODE "SUPERIOR PERFORMANCE WITH MAXIMUM PLACEMENT EFFORT"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to CLK_25M -entity top

# Platform Designer system and its generic components
set_global_assignment -name QSYS_FILE ../qsys/mx_shell.qsys
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_rrip.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_pll.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_jtag_master.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_ccb.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_rst_sys.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_rst_dut.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_clkb_sys.ip
set_global_assignment -name IP_FILE ../qsys/ip/mx_shell/mx_shell_clkb_dut.ip

# RTL: harness + the paper's tensor-mode dot product (unmodified upstream files)
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mxfp_harness.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/bfp_dot.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../upstream/fpga-mxfp/characterization/ai_tensor_block/rtl/fp_aitb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../upstream/fpga-mxfp/characterization/ai_tensor_block/rtl/mxfp_dot.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../upstream/fpga-mxfp/characterization/ai_tensor_block/rtl/pipeline.sv
set_global_assignment -name SDC_FILE top.sdc

# MXFP format of this build (E2M1 = MXFP4). Override with: quartus_sh --set "set_parameter -name E 2"
set_parameter -name E 2
set_parameter -name M 3
set_parameter -name PIPE 1
set_parameter -name DUT_KIND 1
